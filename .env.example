SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

# Used to build the "add more assignments" link at the bottom of each daily
# email. Update this to your real domain once deployed (see README).
APP_BASE_URL=http://localhost:8000

# Random string used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=generate_a_long_random_string_here

# Key used to encrypt each user's app password at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this after users have saved passwords will break decryption for them.
APP_ENCRYPTION_KEY=generate_a_fernet_key_here

# Shared secret for the external cron trigger (see README -- "Deploying for
# real"). Generate with:
#   python -c "import secrets; print(secrets.token_hex(24))"
TRIGGER_SECRET=generate_a_long_random_string_here
